# Copy to .env for local development. On Render, set these in the dashboard.

# Postgres on Render (postgres:// is fine, it's rewritten). Defaults to a local SQLite file.
DATABASE_URL=

# Public URL of this service; needed to validate Twilio signatures behind Render's proxy.
PUBLIC_BASE_URL=https://9send.onrender.com

# Twilio (signature validation turns on automatically when the auth token is set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# VALIDATE_TWILIO_SIGNATURE=true

# --- Providers ---
# COLLECTION_PROVIDER (collects naira):  sandbox | flutterwave | paystack | squad
# PAYOUT_PROVIDER     (pays out cedis):  sandbox | flutterwave | paystack
# Either left empty falls back to PAYMENT_PROVIDER. Sandbox can't be mixed with a real provider.
PAYMENT_PROVIDER=sandbox
COLLECTION_PROVIDER=
PAYOUT_PROVIDER=

# Required by Flutterwave, Paystack and Squad on every payment (the bot doesn't ask customers for one).
CUSTOMER_EMAIL=

# Naira per cedi. Used by the sandbox (default 132) and required for Paystack payouts.
# Flutterwave payouts use Flutterwave's live rate instead.
NGN_PER_GHS=

# Pricing
FEE_PERCENT=1
FX_MARGIN_PERCENT=0
MIN_AMOUNT_NGN=1000
MAX_AMOUNT_NGN=1000000
QUOTE_TTL_MINUTES=15
SESSION_TIMEOUT_MINUTES=30

# --- Sandbox ---
# Secret for signing test POSTs to /webhooks/sandbox (HMAC-SHA256, header X-9send-Signature).
PAYMENT_WEBHOOK_SECRET=
POOL_BANK=Zenith Bank
POOL_ACCOUNT_NUMBER=2214567890
POOL_ACCOUNT_NAME=9SEND POOL

# --- Flutterwave --- webhook URL: <PUBLIC_BASE_URL>/webhooks/flutterwave
FLUTTERWAVE_SECRET_KEY=
# Dashboard > Settings > Webhooks > Secret hash
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_DEBIT_CURRENCY=NGN
# Bank payouts: {"GCB": {"code": "...", "branch": "..."}} from scripts/flutterwave_ghana_banks.py
FLUTTERWAVE_GH_BANKS={}

# --- Paystack --- webhook URL (both businesses): <PUBLIC_BASE_URL>/webhooks/paystack
# Nigerian business, for collecting naira
PAYSTACK_SECRET_KEY=
# Ghanaian business, for paying out cedis (Paystack only allows GHS payouts from Ghana businesses)
PAYSTACK_GH_SECRET_KEY=
# Bank payouts: {"GCB": "<code>"} from scripts/paystack_ghana_banks.py
PAYSTACK_GH_BANKS={}

# --- Squad (collecting only) --- webhook URL: <PUBLIC_BASE_URL>/webhooks/squad
SQUAD_SECRET_KEY=
# Sandbox by default; use https://api-d.squadco.com for live
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
